# =====================================================================
# RoadEye Project - Environment Configuration Template
# Copy this file to .env and configure with your deployment credentials
# =====================================================================

# --- Supabase Cloud Database & Storage ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Supabase Schema & Table Mappings ---
SUPABASE_RIDES_TABLE=rides
SUPABASE_COMPLAINTS_TABLE=detections

# --- Backend Application Secrets ---
FLASK_SECRET_KEY=generate_a_secure_random_hex_key_here

# --- Tailscale Funnel / Edge Ingress Configuration ---
TAILSCALE_FUNNEL_URL=http://localhost:8000
NODE_ID=edge-gpu-node-01
NODE_NAME=Edge GPU Node

# --- Email Alert Dispatcher (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=alerts@yourdomain.com
SMTP_PASS=your_app_specific_password
PMC_EMAIL=civic_authority@yourcity.gov
